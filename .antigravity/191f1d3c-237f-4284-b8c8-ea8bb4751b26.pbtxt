    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { X, History, Trash2, ExternalLink, Clock, Globe } from \"lucide-react\";\nimport { HistoryItem } from \"../../types/browser\";\n\ninterface HistoryDrawerProps {\n  isOpen: boolean;\n  history: HistoryItem[];\n  onSelectHistory: (url: string) => void;\n  onClearHistory: () => void;\n  onClose: () => void;\n}\n\nexport const HistoryDrawer: React.FC<HistoryDrawerProps> = ({\n  isOpen,\n  history,\n  onSelectHistory,\n  onClearHistory,\n  onClose,\n}) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex justify-end bg-slate-950/80 backdrop-blur-md animate-in fade-in\">\n      <div className=\"w-full max-w-md h-full bg-slate-900 border-l border-white/10 p-6 flex flex-col shadow-2xl overflow-hidden\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-4 border-b border-white/10 shrink-0\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2.5 rounded-xl bg-cyan-500/20 text-cyan-300 border border-cyan-500/30\">\n              <History className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-bold text-white\">Browsing Memory</h3>\n              <p className=\"text-xs text-slate-400\">Recently visited web pages during session</p>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            {history.length > 0 && (\n              <button\n                onClick={onClearHistory}\n                className=\"px-2.5 py-1.5 rounded-xl bg-slate-800 hover:bg-red-500/20 text-slate-400 hover:text-red-300 text-xs transition-all flex items-center gap-1\"\n                title=\"Clear History\"\n              >\n                <Trash2 className=\"w-3.5 h-3.5\" />\n                <span>Clear</span>\n              </button>\n            )}\n            <button\n              onClick={onClose}\n              className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-all\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n\n        {/* List */}\n        <div className=\"flex-1 overflow-y-auto py-4 space-y-2.5\">\n          {history.length === 0 ? (\n            <div className=\"text-center py-16 px-4\">\n              <Clock className=\"w-10 h-10 text-slate-600 mx-auto mb-3\" />\n              <p className=\"text-sm font-medium text-slate-300 mb-1\">No browsing history yet</p>\n              <p className=\"text-xs text-slate-500\">\n                Websites you visit in Navi\'s browser will appear here.\n              </p>\n            </div>\n          ) : (\n            history.map((item) => (\n              <div\n                key={item.id + \"_\" + item.visitedAt}\n                className=\"p-3.5 rounded-2xl bg-slate-800/60 border border-white/5 hover:border-cyan-500/30 transition-all flex items-center justify-between gap-3 group\"\n              >\n                <button\n                  onClick={() => {\n                    onSelectHistory(item.url);\n                    onClose();\n                  }}\n                  className=\"flex-1 text-left flex items-center gap-3 overflow-hidden\"\n                >\n                  <div className=\"w-8 h-8 rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 flex items-center justify-center shrink-0\">\n                    <Globe className=\"w-4 h-4\" />\n                  </div>\n                  <div className=\"overflow-hidden\">\n                    <h4 className=\"text-xs font-bold text-white truncate group-hover:text-cyan-300 transition-colors\">\n                      {item.title || item.url}\n                    </h4>\n                    <div className=\"flex items-center gap-2 text-[10px] text-slate-400\">\n                      <span className=\"truncate max-w-[180px]\">{item.url}</span>\n                      <span>\342\200\242</span>\n                      <span>{new Date(item.visitedAt).toLocaleTimeString([], { hour: \"2-digit\", minute: \"2-digit\" })}</span>\n                    </div>\n                  </div>\n                </button>\n                <button\n                  onClick={() => {\n                    onSelectHistory(item.url);\n                    onClose();\n                  }}\n                  className=\"p-2 rounded-xl hover:bg-slate-700 text-slate-400 hover:text-white transition-all shrink-0\"\n                >\n                  <ExternalLink className=\"w-4 h-4\" />\n                </button>\n              </div>\n            ))\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
