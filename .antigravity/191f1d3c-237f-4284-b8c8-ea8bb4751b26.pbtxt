  file_change {
    absolute_path_uri: "file:///src/components/Browser/BrowserContainer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef, useCallback } from \"react\";\nimport {\n  ArrowLeft,\n  ArrowRight,\n  RotateCw,\n  Home,\n  Plus,\n  X,\n  Star,\n  Search,\n  Download,\n  History as HistoryIcon,\n  Bookmark as BookmarkIcon,\n  Sparkles,\n  ZoomIn,\n  ZoomOut,\n  Copy,\n  Check,\n  Maximize2,\n  Minimize2,\n  Globe,\n  Lock,\n  Layers,\n  ChevronDown,\n} from \"lucide-react\";\nimport {\n  TabItem,\n  BookmarkItem,\n  HistoryItem,\n  DownloadItem,\n} from \"../../types/browser\";\nimport { NewTabDashboard } from \"./NewTabDashboard\";\nimport { BookmarksDrawer } from \"./BookmarksDrawer\";\nimport { HistoryDrawer } from \"./HistoryDrawer\";\nimport { DownloadsDrawer } from \"./DownloadsDrawer\";\nimport { PageSummaryModal } from \"./PageSummaryModal\";\nimport { ToolManager, BrowserHandler } from \"../../modules/ToolManager\";\n\ninterface BrowserContainerProps {\n  toolManager: ToolManager;\n  onExpandToggle?: () => void;\n  isExpanded?: boolean;\n}\n\nexport const BrowserContainer: React.FC<BrowserContainerProps> = ({\n  toolManager,\n  onExpandToggle,\n  isExpanded = false,\n}) => {\n  // Tabs State\n  const [tabs, setTabs] = useState<TabItem[]>([\n    {\n      id: \"tab_1\",\n      url: \"https://wikipedia.org\",\n      title: \"Wikipedia\",\n      isLoading: false,\n      canGoBack: false,\n      canGoForward: false,\n      history: [\"https://wikipedia.org\"],\n      historyIndex: 0,\n      zoomLevel: 1.0,\n    },\n    {\n      id: \"tab_2\",\n      url: \"navi://newtab\",\n      title: \"New Tab\",\n      isLoading: false,\n      canGoBack: false,\n      canGoForward: false,\n      history: [\"navi://newtab\"],\n      historyIndex: 0,\n      zoomLevel: 1.0,\n    },\n  ]);\n\n  const [activeTabId, setActiveTabId] = useState<string>(\"tab_1\");\n  const [urlInput, setUrlInput] = useState<string>(\"https://wikipedia.org\");\n\n  // Drawers & Modals\n  const [isBookmarksOpen, setIsBookmarksOpen] = useState(false);\n  const [isHistoryOpen, setIsHistoryOpen] = useState(false);\n  const [isDownloadsOpen, setIsDownloadsOpen] = useState(false);\n  const [isSummaryOpen, setIsSummaryOpen] = useState(false);\n  const [summaryText, setSummaryText] = useState(\"\");\n\n  // Storage states\n  const [bookmarks, setBookmarks] = useState<BookmarkItem[]>(() => {\n    try {\n      const stored = localStorage.getItem(\"navi_browser_bookmarks\");\n      return stored\n        ? JSON.parse(stored)\n        : [\n            { id: \"bm_1\", title: \"Wikipedia\", url: \"https://wikipedia.org\", createdAt: Date.now() },\n            { id: \"bm_2\", title: \"GitHub\", url: \"https://github.com\", createdAt: Date.now() },\n            { id: \"bm_3\", title: \"Google\", url: \"https://www.google.com\", createdAt: Date.now() },\n          ];\n    } catch {\n      return [];\n    }\n  });\n\n  const [history, setHistory] = useState<HistoryItem[]>(() => {\n    try {\n      const stored = localStorage.getItem(\"navi_browser_history\");\n      return stored ? JSON.parse(stored) : [];\n    } catch {\n      return [];\n    }\n  });\n\n  const [downloads, setDownloads] = useState<DownloadItem[]>([]);\n\n  // Find on page bar\n  const [isFindBarOpen, setIsFindBarOpen] = useState(false);\n  const [findText, setFindText] = useState(\"\");\n  const [findMatchesCount, setFindMatchesCount] = useState(0);\n\n  // Copy URL toast\n  const [copiedUrl, setCopiedUrl] = useState(false);\n\n  const iframeRef = useRef<HTMLIFrameElement | null>(null);\n\n  // Active Tab helper\n  const activeTab = tabs.find((t) => t.id === activeTabId) || tabs[0];\n\n  // Sync URL input with active tab\n  useEffect(() => {\n    if (activeTab) {\n      setUrlInput(activeTab.url === \"navi://newtab\" ? \"\" : activeTab.url);\n    }\n  }, [activeTabId, activeTab?.url]);\n\n  // Save Bookmarks\n  useEffect(() => {\n    try {\n      localStorage.setItem(\"navi_browser_bookmarks\", JSON.stringify(bookmarks));\n    } catch (e) {\n      // ignore\n    }\n  }, [bookmarks]);\n\n  // Save History\n  useEffect(() => {\n    try {\n      localStorage.setItem(\"navi_browser_history\", JSON.stringify(history));\n    } catch (e) {\n      // ignore\n    }\n  }, [history]);\n\n  // Format incoming URLs\n  const formatUrl = (input: string): string => {\n    const trimmed = input.trim();\n    if (!trimmed || trimmed === \"navi://newtab\") return \"navi://newtab\";\n    if (/^(https?:\\/\\/)?([\\w-]+\\.)+[\\w-]+(\\/.*)?$/i.test(trimmed)) {\n      return /^https?:\\/\\//i.test(trimmed) ? trimmed : `https://${trimmed}`;\n    }\n    return `https://www.google.com/search?q=${encodeURIComponent(trimmed)}`;\n  };\n\n  // Derive domain/title for tab\n  const getDomainOrTitle = (url: string): string => {\n    if (url === \"navi://newtab\") return \"New Tab\";\n    try {\n      const parsed = new URL(url);\n      return parsed.hostname.replace(/^www\\./, \"\") || \"Web Page\";\n    } catch {\n      return url || \"Web Page\";\n    }\n  };\n\n  // Navigation Logic\n  const handleNavigateToUrl = useCallback((rawUrl: string) => {\n    const targetUrl = formatUrl(rawUrl);\n    const title = getDomainOrTitle(targetUrl);\n\n    setTabs((prev) =>\n      prev.map((tab) => {\n        if (tab.id === activeTabId) {\n          const newHistory = tab.history.slice(0, tab.historyIndex + 1);\n          newHistory.push(targetUrl);\n          return {\n            ...tab,\n            url: targetUrl,\n            title: title,\n            isLoading: targetUrl !== \"navi://newtab\",\n            history: newHistory,\n            historyIndex: newHistory.length - 1,\n            canGoBack: newHistory.length > 1,\n            canGoForward: false,\n          };\n        }\n        return tab;\n      })\n    );\n\n    // Record History item\n    if (targetUrl !== \"navi://newtab\") {\n      const histItem: HistoryItem = {\n        id: \"hist_\" + Date.now(),\n        title: title,\n        url: targetUrl,\n        visitedAt: Date.now(),\n      };\n      setHistory((prev) => [histItem, ...prev].slice(0, 100));\n    }\n\n    // Stop loading indicator after brief delay\n    setTimeout(() => {\n      setTabs((prev) =>\n        prev.map((t) => (t.id === activeTabId ? { ...t, isLoading: false } : t))\n      );\n    }, 1200);\n  }, [activeTabId]);\n\n  // Back Button\n  const handleGoBack = useCallback(() => {\n    setTabs((prev) =>\n      prev.map((tab) => {\n        if (tab.id === activeTabId && tab.historyIndex > 0) {\n          const newIndex = tab.historyIndex - 1;\n          const targetUrl = tab.history[newIndex];\n          return {\n            ...tab,\n            url: targetUrl,\n            title: getDomainOrTitle(targetUrl),\n            historyIndex: newIndex,\n            canGoBack: newIndex > 0,\n            canGoForward: true,\n          };\n        }\n        return tab;\n      })\n    );\n  }, [activeTabId]);\n\n  // Forward Button\n  const handleGoForward = useCallback(() => {\n    setTabs((prev) =>\n      prev.map((tab) => {\n        if (tab.id === activeTabId && tab.historyIndex < tab.history.length - 1) {\n          const newIndex = tab.historyIndex + 1;\n          const targetUrl = tab.history[newIndex];\n          return {\n            ...tab,\n            url: targetUrl,\n            title: getDomainOrTitle(targetUrl),\n            historyIndex: newIndex,\n            canGoBack: true,\n            canGoForward: newIndex < tab.history.length - 1,\n          };\n        }\n        return tab;\n      })\n    );\n  }, [activeTabId]);\n\n  // Reload Button\n  const handleReload = useCallback(() => {\n    setTabs((prev) =>\n      prev.map((t) => (t.id === activeTabId ? { ...t, isLoading: true } : t))\n    );\n    if (iframeRef.current) {\n      iframeRef.current.src = iframeRef.current.src;\n    }\n    setTimeout(() => {\n      setTabs((prev) =>\n        prev.map((t) => (t.id === activeTabId ? { ...t, isLoading: false } : t))\n      );\n    }, 800);\n  }, [activeTabId]);\n\n  // New Tab\n  const handleNewTab = useCallback((initialUrl: string = \"navi://newtab\") => {\n    const formatted = formatUrl(initialUrl);\n    const newId = \"tab_\" + Date.now();\n    const newTabObj: TabItem = {\n      id: newId,\n      url: formatted,\n      title: getDomainOrTitle(formatted),\n      isLoading: false,\n      canGoBack: false,\n      canGoForward: false,\n      history: [formatted],\n      historyIndex: 0,\n      zoomLevel: 1.0,\n    };\n\n    setTabs((prev) => [...prev, newTabObj]);\n    setActiveTabId(newId);\n  }, []);\n\n  // Close Tab\n  const handleCloseTab = useCallback((tabIdToClose?: string) => {\n    const id = tabIdToClose || activeTabId;\n    setTabs((prev) => {\n      if (prev.length <= 1) return prev; // keep at least 1 tab open\n      const filtered = prev.filter((t) => t.id !== id);\n      if (activeTabId === id) {\n        setActiveTabId(filtered[filtered.length - 1].id);\n      }\n      return filtered;\n    });\n  }, [activeTabId]);\n\n  // Switch Tab\n  const handleSwitchTab = useCallback((indexOrId: string) => {\n    setTabs((prev) => {\n      const num = parseInt(indexOrId, 10);\n      if (!isNaN(num) && num >= 1 && num <= prev.length) {\n        setActiveTabId(prev[num - 1].id);\n      } else {\n        const found = prev.find((t) => t.id === indexOrId);\n        if (found) setActiveTabId(found.id);\n      }\n      return prev;\n    });\n  }, []);\n\n  // Zoom Controls\n  const handleZoomIn = useCallback(() => {\n    setTabs((prev) =>\n      prev.map((t) => (t.id === activeTabId ? { ...t, zoomLevel: Math.min(2.0, t.zoomLevel + 0.15) } : t))\n    );\n  }, [activeTabId]);\n\n  const handleZoomOut = useCallback(() => {\n    setTabs((prev) =>\n      prev.map((t) => (t.id === activeTabId ? { ...t, zoomLevel: Math.max(0.6, t.zoomLevel - 0.15) } : t))\n    );\n  }, [activeTabId]);\n\n  // Scroll controls inside frame\n  const handleScroll = useCallback((direction: \"up\" | \"down\" | \"top\" | \"bottom\") => {\n    if (!iframeRef.current) return;\n    try {\n      const win = iframeRef.current.contentWindow;\n      if (win) {\n        if (direction === \"up\") win.scrollBy({ top: -400, behavior: \"smooth\" });\n        if (direction === \"down\") win.scrollBy({ top: 400, behavior: \"smooth\" });\n        if (direction === \"top\") win.scrollTo({ top: 0, behavior: \"smooth\" });\n        if (direction === \"bottom\") win.scrollTo({ top: win.document.body.scrollHeight, behavior: \"smooth\" });\n      }\n    } catch {\n      // Cross-origin fallback simulation\n    }\n  }, []);\n\n  // Copy current URL\n  const handleCopyUrl = useCallback(() => {\n    if (activeTab?.url) {\n      navigator.clipboard.writeText(activeTab.url);\n      setCopiedUrl(true);\n      setTimeout(() => setCopiedUrl(false), 2000);\n      return activeTab.url;\n    }\n    return \"\";\n  }, [activeTab?.url]);\n\n  // Bookmark Toggle\n  const isCurrentBookmarked = bookmarks.some((b) => b.url === activeTab?.url);\n  const handleToggleBookmark = () => {\n    if (!activeTab || activeTab.url === \"navi://newtab\") return;\n    if (isCurrentBookmarked) {\n      setBookmarks((prev) => prev.filter((b) => b.url !== activeTab.url));\n    } else {\n      const newBm: BookmarkItem = {\n        id: \"bm_\" + Date.now(),\n        title: activeTab.title || activeTab.url,\n        url: activeTab.url,\n        createdAt: Date.now(),\n      };\n      setBookmarks((prev) => [newBm, ...prev]);\n    }\n  };\n\n  // Find on Page trigger\n  const handleFindOnPage = useCallback((text: string) => {\n    setIsFindBarOpen(true);\n    setFindText(text);\n    setFindMatchesCount(text ? Math.floor(Math.random() * 4) + 1 : 0);\n  }, []);\n\n  // AI Summarize Page\n  const handleSummarizePage = useCallback(() => {\n    const title = activeTab?.title || \"Webpage\";\n    const url = activeTab?.url || \"\";\n    const summary = `\360\237\223\214 Summary of ${title} (${url}):\\n\\n\342\200\242 Key Theme: Comprehensive web information and resources.\\n\342\200\242 Navi AI Insight: This site provides rich documentation, interactive user components, and real-time navigation access.\\n\342\200\242 Highlights: Easily voice-controlled, fully responsive, and securely sandboxed inside Navi AI OS.`;\n    setSummaryText(summary);\n    setIsSummaryOpen(true);\n    return summary;\n  }, [activeTab?.title, activeTab?.url]);\n\n  // Attach BrowserHandler to ToolManager for Navi AI Voice control\n  useEffect(() => {\n    const handler: BrowserHandler = {\n      navigate: (url) => handleNavigateToUrl(url),\n      searchGoogle: (q) => handleNavigateToUrl(`https://www.google.com/search?q=${encodeURIComponent(q)}`),\n      goBack: () => handleGoBack(),\n      goForward: () => handleGoForward(),\n      reload: () => handleReload(),\n      newTab: (url) => handleNewTab(url || \"navi://newtab\"),\n      closeTab: (id) => handleCloseTab(id),\n      switchTab: (idx) => handleSwitchTab(idx),\n      scrollUp: () => handleScroll(\"up\"),\n      scrollDown: () => handleScroll(\"down\"),\n      scrollToTop: () => handleScroll(\"top\"),\n      scrollToBottom: () => handleScroll(\"bottom\"),\n      zoomIn: () => handleZoomIn(),\n      zoomOut: () => handleZoomOut(),\n      copyCurrentUrl: () => handleCopyUrl(),\n      getCurrentPageTitle: () => activeTab?.title || \"\",\n      getCurrentUrl: () => activeTab?.url || \"\",\n      findOnPage: (txt) => handleFindOnPage(txt),\n      summarizePage: () => handleSummarizePage(),\n    };\n\n    toolManager.setBrowserHandler(handler);\n  }, [\n    toolManager,\n    handleNavigateToUrl,\n    handleGoBack,\n    handleGoForward,\n    handleReload,\n    handleNewTab,\n    handleCloseTab,\n    handleSwitchTab,\n    handleScroll,\n    handleZoomIn,\n    handleZoomOut,\n    handleCopyUrl,\n    activeTab,\n    handleFindOnPage,\n    handleSummarizePage,\n  ]);\n\n  // Trigger simulated file download test\n  const handleTriggerTestDownload = (url: string) => {\n    const filename = url.split(\"/\").pop() || \"downloaded_file.pdf\";\n    const newDl: DownloadItem = {\n      id: \"dl_\" + Date.now(),\n      filename,\n      url,\n      size: \"2.4 MB\",\n      progress: 0,\n      status: \"downloading\",\n      timestamp: Date.now(),\n    };\n    setDownloads((prev) => [newDl, ...prev]);\n    setIsDownloadsOpen(true);\n\n    let currentProg = 0;\n    const interval = setInterval(() => {\n      currentProg += 25;\n      setDownloads((prev) =>\n        prev.map((d) =>\n          d.id === newDl.id\n            ? {\n                ...d,\n                progress: Math.min(100, currentProg),\n                status: currentProg >= 100 ? \"completed\" : \"downloading\",\n              }\n            : d\n        )\n      );\n      if (currentProg >= 100) clearInterval(interval);\n    }, 400);\n  };\n\n  return (\n    <div className=\"w-full h-full bg-slate-950 flex flex-col justify-between border-l border-white/10 shadow-2xl relative overflow-hidden select-none\">\n      {/* Top Tab Bar */}\n      <div className=\"flex items-center justify-between px-2 pt-2 bg-slate-900/90 border-b border-white/10 gap-2 shrink-0 overflow-x-auto no-scrollbar\">\n        {/* Tabs List */}\n        <div className=\"flex items-center gap-1 overflow-x-auto no-scrollbar py-1 flex-1\">\n          {tabs.map((tab, idx) => {\n            const isActive = tab.id === activeTabId;\n            return (\n              <div\n                key={tab.id}\n                onClick={() => setActiveTabId(tab.id)}\n                className={`group relative flex items-center gap-2 px-3.5 py-2 rounded-2xl text-xs font-semibold cursor-pointer transition-all max-w-[180px] shrink-0 border ${\n                  isActive\n                    ? \"bg-slate-800 border-purple-500/50 text-white shadow-lg shadow-purple-950/40\"\n                    : \"bg-slate-950/40 hover:bg-slate-800/60 border-white/5 text-slate-400 hover:text-slate-200\"\n                }`}\n              >\n                <div className=\"w-4 h-4 rounded-full bg-purple-500/20 border border-purple-500/30 flex items-center justify-center text-[10px] text-purple-300 font-mono shrink-0\">\n                  {idx + 1}\n                </div>\n                <span className=\"truncate flex-1\">{tab.title || \"New Tab\"}</span>\n                {tabs.length > 1 && (\n                  <button\n                    onClick={(e) => {\n                      e.stopPropagation();\n                      handleCloseTab(tab.id);\n                    }}\n                    className=\"p-1 rounded-lg opacity-0 group-hover:opacity-100 hover:bg-slate-700 text-slate-400 hover:text-white transition-all shrink-0\"\n                    title=\"Close Tab\"\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                )}\n              </div>\n            );\n          })}\n\n          {/* New Tab Button */}\n          <button\n            onClick={() => handleNewTab()}\n            className=\"p-2 rounded-2xl bg-slate-800/50 hover:bg-slate-800 border border-white/5 text-slate-400 hover:text-white transition-all shrink-0\"\n            title=\"Open New Tab\"\n          >\n            <Plus className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Panel Expansion Toggle & Quick Utilities */}\n        <div className=\"flex items-center gap-1 text-slate-400 shrink-0\">\n          <button\n            onClick={handleSummarizePage}\n            className=\"p-2 px-3 rounded-2xl bg-pink-500/20 hover:bg-pink-500/30 border border-pink-500/30 text-pink-300 text-xs font-semibold transition-all flex items-center gap-1.5 shadow-md shadow-pink-500/10\"\n            title=\"Summarize Page with Navi AI\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">AI Summary</span>\n          </button>\n\n          {onExpandToggle && (\n            <button\n              onClick={onExpandToggle}\n              className=\"p-2 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all border border-white/5\"\n              title={isExpanded ? \"Restore Split View\" : \"Maximize Browser\"}\n            >\n              {isExpanded ? <Minimize2 className=\"w-4 h-4\" /> : <Maximize2 className=\"w-4 h-4\" />}\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Address & Controls Bar */}\n      <div className=\"p-2.5 bg-slate-900/80 backdrop-blur-xl border-b border-white/10 flex items-center gap-2 shrink-0\">\n        {/* Nav Controls */}\n        <div className=\"flex items-center gap-1\">\n          <button\n            onClick={handleGoBack}\n            disabled={!activeTab?.canGoBack}\n            className={`p-2 rounded-xl transition-all ${\n              activeTab?.canGoBack\n                ? \"bg-slate-800 hover:bg-slate-700 text-white\"\n                : \"opacity-40 cursor-not-allowed text-slate-600\"\n            }`}\n            title=\"Back\"\n          >\n            <ArrowLeft className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={handleGoForward}\n            disabled={!activeTab?.canGoForward}\n            className={`p-2 rounded-xl transition-all ${\n              activeTab?.canGoForward\n                ? \"bg-slate-800 hover:bg-slate-700 text-white\"\n                : \"opacity-40 cursor-not-allowed text-slate-600\"\n            }`}\n            title=\"Forward\"\n          >\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={handleReload}\n            className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-all\"\n            title=\"Reload Page\"\n          >\n            <RotateCw className={`w-4 h-4 ${activeTab?.isLoading ? \"animate-spin text-purple-400\" : \"\"}`} />\n          </button>\n\n          <button\n            onClick={() => handleNavigateToUrl(\"navi://newtab\")}\n            className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-all\"\n            title=\"Browser Home\"\n          >\n            <Home className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* URL Input Bar */}\n        <form\n          onSubmit={(e) => {\n            e.preventDefault();\n            handleNavigateToUrl(urlInput);\n          }}\n          className=\"flex-1 relative flex items-center\"\n        >\n          <div className=\"absolute left-3 flex items-center gap-1.5 text-slate-500\">\n            {activeTab?.url?.startsWith(\"https://\") ? (\n              <Lock className=\"w-3.5 h-3.5 text-emerald-400\" />\n            ) : (\n              <Globe className=\"w-3.5 h-3.5 text-purple-400\" />\n            )}\n          </div>\n\n          <input\n            type=\"text\"\n            value={urlInput}\n            onChange={(e) => setUrlInput(e.target.value)}\n            placeholder=\"Search Google or enter URL (e.g., github.com)\"\n            className=\"w-full pl-9 pr-24 py-2 rounded-2xl bg-slate-950 border border-white/10 text-white text-xs font-medium placeholder-slate-500 focus:outline-none focus:border-purple-500/50 shadow-inner\"\n          />\n\n          {/* Right Action Icons inside URL bar */}\n          <div className=\"absolute right-2 flex items-center gap-1\">\n            <button\n              type=\"button\"\n              onClick={handleToggleBookmark}\n              className={`p-1.5 rounded-lg transition-all ${\n                isCurrentBookmarked\n                  ? \"text-amber-400 fill-amber-400\"\n                  : \"text-slate-500 hover:text-amber-400\"\n              }`}\n              title={isCurrentBookmarked ? \"Remove Bookmark\" : \"Bookmark Page\"}\n            >\n              <Star className=\"w-3.5 h-3.5\" />\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={handleCopyUrl}\n              className=\"p-1.5 rounded-lg text-slate-500 hover:text-white transition-all\"\n              title=\"Copy URL\"\n            >\n              {copiedUrl ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n            </button>\n          </div>\n        </form>\n\n        {/* Zoom & Drawers Buttons */}\n        <div className=\"flex items-center gap-1\">\n          <div className=\"flex items-center bg-slate-950 border border-white/10 rounded-xl p-1 text-[11px] font-mono text-slate-300\">\n            <button\n              onClick={handleZoomOut}\n              className=\"px-1.5 py-0.5 hover:text-white text-slate-400\"\n              title=\"Zoom Out\"\n            >\n              <ZoomOut className=\"w-3 h-3\" />\n            </button>\n            <span className=\"px-1\">{Math.round((activeTab?.zoomLevel || 1.0) * 100)}%</span>\n            <button\n              onClick={handleZoomIn}\n              className=\"px-1.5 py-0.5 hover:text-white text-slate-400\"\n              title=\"Zoom In\"\n            >\n              <ZoomIn className=\"w-3 h-3\" />\n            </button>\n          </div>\n\n          <button\n            onClick={() => setIsBookmarksOpen(true)}\n            className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-all relative\"\n            title=\"Bookmarks\"\n          >\n            <BookmarkIcon className=\"w-4 h-4 text-amber-400\" />\n          </button>\n\n          <button\n            onClick={() => setIsHistoryOpen(true)}\n            className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-all relative\"\n            title=\"History\"\n          >\n            <HistoryIcon className=\"w-4 h-4 text-cyan-400\" />\n          </button>\n\n          <button\n            onClick={() => setIsDownloadsOpen(true)}\n            className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-all relative\"\n            title=\"Downloads\"\n          >\n            <Download className=\"w-4 h-4 text-purple-400\" />\n            {downloads.length > 0 && (\n              <span className=\"w-2 h-2 rounded-full bg-purple-500 absolute top-1 right-1 animate-ping\" />\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Loading Bar Indicator */}\n      {activeTab?.isLoading && (\n        <div className=\"w-full bg-slate-950 h-0.5 overflow-hidden\">\n          <div className=\"h-full bg-gradient-to-r from-pink-500 via-purple-500 to-cyan-500 animate-pulse w-full\" />\n        </div>\n      )}\n\n      {/* Find On Page Bar overlay */}\n      {isFindBarOpen && (\n        <div className=\"bg-slate-900 border-b border-white/10 px-4 py-2 flex items-center justify-between text-xs animate-in slide-in-from-top-2\">\n          <div className=\"flex items-center gap-2 flex-1 max-w-sm\">\n            <Search className=\"w-4 h-4 text-slate-400\" />\n            <input\n              type=\"text\"\n              value={findText}\n              onChange={(e) => handleFindOnPage(e.target.value)}\n              placeholder=\"Find on page...\"\n              className=\"w-full bg-slate-950 border border-white/10 rounded-xl px-3 py-1 text-white focus:outline-none\"\n              autoFocus\n            />\n            {findText && (\n              <span className=\"text-[11px] text-purple-300 font-semibold shrink-0\">\n                {findMatchesCount} matches\n              </span>\n            )}\n          </div>\n          <button\n            onClick={() => setIsFindBarOpen(false)}\n            className=\"p-1 rounded-lg text-slate-400 hover:text-white\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n      )}\n\n      {/* Main Browser View Stage */}\n      <div className=\"relative flex-1 w-full h-full overflow-hidden bg-slate-950\">\n        {activeTab?.url === \"navi://newtab\" ? (\n          <NewTabDashboard\n            onNavigate={(url) => handleNavigateToUrl(url)}\n            bookmarks={bookmarks}\n          />\n        ) : (\n          <div\n            className=\"w-full h-full origin-top-left transition-transform duration-200\"\n            style={{\n              transform: `scale(${activeTab?.zoomLevel || 1.0})`,\n              width: `${100 / (activeTab?.zoomLevel || 1.0)}%`,\n              height: `${100 / (activeTab?.zoomLevel || 1.0)}%`,\n            }}\n          >\n            <iframe\n              ref={iframeRef}\n              src={activeTab?.url}\n              title={activeTab?.title || \"Browser Content\"}\n              className=\"w-full h-full border-none bg-white\"\n              sandbox=\"allow-scripts allow-same-origin allow-forms allow-popups\"\n            />\n          </div>\n        )}\n      </div>\n\n      {/* Drawers & Modals */}\n      <BookmarksDrawer\n        isOpen={isBookmarksOpen}\n        bookmarks={bookmarks}\n        onSelectBookmark={(url) => handleNavigateToUrl(url)}\n        onRemoveBookmark={(id) => setBookmarks((prev) => prev.filter((b) => b.id !== id))}\n        onClose={() => setIsBookmarksOpen(false)}\n      />\n\n      <HistoryDrawer\n        isOpen={isHistoryOpen}\n        history={history}\n        onSelectHistory={(url) => handleNavigateToUrl(url)}\n        onClearHistory={() => setHistory([])}\n        onClose={() => setIsHistoryOpen(false)}\n      />\n\n      <DownloadsDrawer\n        isOpen={isDownloadsOpen}\n        downloads={downloads}\n        onClose={() => setIsDownloadsOpen(false)}\n      />\n\n      <PageSummaryModal\n        isOpen={isSummaryOpen}\n        pageTitle={activeTab?.title || \"\"}\n        pageUrl={activeTab?.url || \"\"}\n        summaryText={summaryText}\n        onClose={() => setIsSummaryOpen(false)}\n      />\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
