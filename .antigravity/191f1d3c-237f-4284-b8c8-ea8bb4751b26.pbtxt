  file_change {
    absolute_path_uri: "file:///src/components/FloatingCompanionWidget.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef } from \"react\";\nimport {\n  Mic,\n  MicOff,\n  Pause,\n  Play,\n  Square,\n  Sparkles,\n  Music,\n  Globe,\n  Radio,\n  StickyNote,\n  Terminal,\n  Volume2,\n  VolumeX,\n  GripHorizontal,\n  ChevronDown,\n  ChevronUp,\n  Settings,\n  X,\n  Compass,\n} from \"lucide-react\";\nimport { SessionState } from \"../modules/LiveSession\";\nimport { VoiceOrbCanvas } from \"./VoiceOrbCanvas\";\n\ninterface FloatingCompanionWidgetProps {\n  state: SessionState;\n  isMuted: boolean;\n  currentAction: string;\n  currentMediaTitle: string;\n  latestTranscript: { text: string; role: \"user\" | \"model\"; isFinal: boolean } | null;\n  inputVolume: number;\n  outputVolume: number;\n  activeTheme: string;\n  activeVoice: string;\n  activeAmbientSound: string;\n  noteCount: number;\n  toolLogCount: number;\n  onToggleSession: () => void;\n  onToggleMute: () => void;\n  onOpenVoiceModal: () => void;\n  onOpenAmbientModal: () => void;\n  onOpenNotesDrawer: () => void;\n  onOpenToolLogsDrawer: () => void;\n  onOpenSettingsModal: () => void;\n  onOpenThemeModal: () => void;\n}\n\nexport const FloatingCompanionWidget: React.FC<FloatingCompanionWidgetProps> = ({\n  state,\n  isMuted,\n  currentAction,\n  currentMediaTitle,\n  latestTranscript,\n  inputVolume,\n  outputVolume,\n  activeTheme,\n  activeVoice,\n  activeAmbientSound,\n  noteCount,\n  toolLogCount,\n  onToggleSession,\n  onToggleMute,\n  onOpenVoiceModal,\n  onOpenAmbientModal,\n  onOpenNotesDrawer,\n  onOpenToolLogsDrawer,\n  onOpenSettingsModal,\n  onOpenThemeModal,\n}) => {\n  // Widget Drag Position State (default top-right corner)\n  const [position, setPosition] = useState<{ x: number; y: number }>({\n    x: window.innerWidth - 380,\n    y: 24,\n  });\n  const [isDragging, setIsDragging] = useState(false);\n  const [dragOffset, setDragOffset] = useState<{ x: number; y: number }>({ x: 0, y: 0 });\n  const [isCollapsed, setIsCollapsed] = useState(false);\n  const [isPaused, setIsPaused] = useState(false);\n\n  const widgetRef = useRef<HTMLDivElement | null>(null);\n\n  // Keep inside screen bounds on window resize\n  useEffect(() => {\n    const handleResize = () => {\n      setPosition((prev) => ({\n        x: Math.min(prev.x, window.innerWidth - 320),\n        y: Math.min(prev.y, window.innerHeight - 150),\n      }));\n    };\n    window.addEventListener(\"resize\", handleResize);\n    return () => window.removeEventListener(\"resize\", handleResize);\n  }, []);\n\n  // Mouse Drag Handlers\n  const handleMouseDown = (e: React.MouseEvent) => {\n    if (widgetRef.current) {\n      const rect = widgetRef.current.getBoundingClientRect();\n      setDragOffset({\n        x: e.clientX - rect.left,\n        y: e.clientY - rect.top,\n      });\n      setIsDragging(true);\n    }\n  };\n\n  useEffect(() => {\n    const handleMouseMove = (e: MouseEvent) => {\n      if (!isDragging) return;\n      const newX = Math.max(12, Math.min(window.innerWidth - 360, e.clientX - dragOffset.x));\n      const newY = Math.max(12, Math.min(window.innerHeight - 200, e.clientY - dragOffset.y));\n      setPosition({ x: newX, y: newY });\n    };\n\n    const handleMouseUp = () => {\n      if (isDragging) setIsDragging(false);\n    };\n\n    if (isDragging) {\n      window.addEventListener(\"mousemove\", handleMouseMove);\n      window.addEventListener(\"mouseup\", handleMouseUp);\n    }\n\n    return () => {\n      window.removeEventListener(\"mousemove\", handleMouseMove);\n      window.removeEventListener(\"mouseup\", handleMouseUp);\n    };\n  }, [isDragging, dragOffset]);\n\n  // Touch Drag Handlers\n  const handleTouchStart = (e: React.TouchEvent) => {\n    if (widgetRef.current && e.touches.length > 0) {\n      const touch = e.touches[0];\n      const rect = widgetRef.current.getBoundingClientRect();\n      setDragOffset({\n        x: touch.clientX - rect.left,\n        y: touch.clientY - rect.top,\n      });\n      setIsDragging(true);\n    }\n  };\n\n  const handleTouchMove = (e: React.TouchEvent) => {\n    if (!isDragging || e.touches.length === 0) return;\n    const touch = e.touches[0];\n    const newX = Math.max(12, Math.min(window.innerWidth - 340, touch.clientX - dragOffset.x));\n    const newY = Math.max(12, Math.min(window.innerHeight - 180, touch.clientY - dragOffset.y));\n    setPosition({ x: newX, y: newY });\n  };\n\n  const handleTouchEnd = () => {\n    setIsDragging(false);\n  };\n\n  // Dynamic Status Badge\n  const getStatusBadge = () => {\n    if (state === \"connecting\") {\n      return (\n        <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/20 border border-amber-500/30 text-amber-300 text-[11px] font-bold animate-pulse\">\n          <span className=\"w-2 h-2 rounded-full bg-amber-400\" /> Connecting...\n        </span>\n      );\n    }\n    if (state === \"listening\") {\n      return (\n        <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-[11px] font-bold\">\n          <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" /> Listening\n        </span>\n      );\n    }\n    if (state === \"speaking\") {\n      return (\n        <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-pink-500/20 border border-pink-500/30 text-pink-300 text-[11px] font-bold\">\n          <span className=\"w-2 h-2 rounded-full bg-pink-400 animate-pulse\" /> Speaking\n        </span>\n      );\n    }\n    return (\n      <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-800/80 border border-white/10 text-slate-400 text-[11px] font-bold\">\n        <span className=\"w-2 h-2 rounded-full bg-slate-500\" /> Offline\n      </span>\n    );\n  };\n\n  return (\n    <div\n      ref={widgetRef}\n      style={{\n        left: `${position.x}px`,\n        top: `${position.y}px`,\n      }}\n      className={`fixed z-50 w-80 sm:w-96 rounded-3xl bg-slate-900/85 backdrop-blur-2xl border border-white/15 shadow-2xl transition-shadow ${\n        isDragging ? \"shadow-purple-500/30 ring-2 ring-purple-500/50 cursor-grabbing\" : \"shadow-black/80\"\n      } select-none overflow-hidden text-white font-sans`}\n    >\n      {/* DRAG HEADER HANDLE */}\n      <div\n        onMouseDown={handleMouseDown}\n        onTouchStart={handleTouchStart}\n        onTouchMove={handleTouchMove}\n        onTouchEnd={handleTouchEnd}\n        className=\"w-full px-4 py-2.5 bg-slate-950/70 border-b border-white/10 flex items-center justify-between cursor-grab active:cursor-grabbing hover:bg-slate-950/90 transition-colors\"\n      >\n        <div className=\"flex items-center gap-2\">\n          <GripHorizontal className=\"w-4 h-4 text-purple-400\" />\n          <div className=\"flex items-center gap-1.5\">\n            <Sparkles className=\"w-3.5 h-3.5 text-pink-400 animate-pulse\" />\n            <span className=\"text-xs font-extrabold tracking-wide text-white\">Navi AI Assistant</span>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-1\">\n          {getStatusBadge()}\n          <button\n            onClick={() => setIsCollapsed(!isCollapsed)}\n            className=\"p-1 rounded-lg hover:bg-slate-800 text-slate-400 hover:text-white transition-all ml-1\"\n            title={isCollapsed ? \"Expand Widget\" : \"Collapse Widget\"}\n          >\n            {isCollapsed ? <ChevronDown className=\"w-4 h-4\" /> : <ChevronUp className=\"w-4 h-4\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* COMPACT MAIN WIDGET BODY */}\n      {!isCollapsed && (\n        <div className=\"p-4 space-y-3.5\">\n          {/* Top Row: Chrome Action Indicator */}\n          <div className=\"p-2.5 rounded-2xl bg-slate-950/80 border border-white/10 flex items-center justify-between gap-2 shadow-inner\">\n            <div className=\"flex items-center gap-2 overflow-hidden\">\n              <div className=\"p-1.5 rounded-xl bg-purple-500/20 text-purple-300 border border-purple-500/30 shrink-0\">\n                <Globe className=\"w-4 h-4\" />\n              </div>\n              <div className=\"overflow-hidden\">\n                <p className=\"text-[10px] font-bold uppercase text-purple-400 tracking-wider\">System Chrome Status</p>\n                <p className=\"text-xs font-semibold text-slate-200 truncate\">\n                  {currentAction || \"Google Chrome Ready\"}\n                </p>\n              </div>\n            </div>\n            <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 font-mono shrink-0\">\n              Active\n            </span>\n          </div>\n\n          {/* Now Playing / Media Title Banner if present */}\n          {(currentMediaTitle || activeAmbientSound !== \"none\") && (\n            <div className=\"p-2.5 rounded-2xl bg-gradient-to-r from-pink-950/60 to-purple-950/60 border border-pink-500/30 flex items-center gap-2.5 shadow-md animate-in fade-in\">\n              <Music className=\"w-4 h-4 text-pink-400 animate-bounce shrink-0\" />\n              <div className=\"overflow-hidden flex-1\">\n                <p className=\"text-[10px] font-bold text-pink-300 uppercase tracking-wider\">Current Media Stream</p>\n                <p className=\"text-xs font-semibold text-white truncate\">\n                  {currentMediaTitle || `Ambient: ${activeAmbientSound}`}\n                </p>\n              </div>\n            </div>\n          )}\n\n          {/* Center Orb & Waveform Stage */}\n          <div className=\"relative w-full h-32 rounded-2xl bg-slate-950/90 border border-white/5 overflow-hidden flex items-center justify-center shadow-inner\">\n            <VoiceOrbCanvas\n              state={state}\n              inputVolume={inputVolume}\n              outputVolume={outputVolume}\n              theme={activeTheme}\n            />\n\n            {/* Offline Tap Prompt inside orb stage */}\n            {state === \"disconnected\" && (\n              <button\n                onClick={onToggleSession}\n                className=\"absolute inset-0 z-10 flex flex-col items-center justify-center bg-slate-950/70 hover:bg-slate-950/50 backdrop-blur-sm transition-all group\"\n              >\n                <div className=\"w-12 h-12 rounded-full bg-gradient-to-r from-pink-500 to-purple-600 flex items-center justify-center shadow-lg shadow-pink-500/30 group-hover:scale-110 transition-transform mb-1\">\n                  <Mic className=\"w-6 h-6 text-white\" />\n                </div>\n                <span className=\"text-xs font-bold text-slate-200\">Click to Wake Navi</span>\n              </button>\n            )}\n          </div>\n\n          {/* Subtitles Preview Snippet */}\n          {latestTranscript && (\n            <div className=\"p-2.5 rounded-xl bg-slate-950/70 border border-white/5 text-xs text-slate-300 flex items-start gap-2\">\n              <span className=\"text-purple-400 font-bold shrink-0\">\n                {latestTranscript.role === \"user\" ? \"You:\" : \"Navi:\"}\n              </span>\n              <p className=\"line-clamp-2 italic text-slate-200 leading-snug\">\n                \"{latestTranscript.text}\"\n              </p>\n            </div>\n          )}\n\n          {/* Main Action Control Buttons Row */}\n          <div className=\"grid grid-cols-4 gap-2 pt-1\">\n            {/* Mic Mute Toggle Button */}\n            <button\n              onClick={onToggleMute}\n              disabled={state === \"disconnected\"}\n              className={`p-3 rounded-2xl flex flex-col items-center justify-center gap-1 transition-all border ${\n                isMuted\n                  ? \"bg-red-500/20 border-red-500/40 text-red-300\"\n                  : \"bg-slate-800 hover:bg-slate-700 border-white/10 text-slate-200\"\n              } ${state === \"disconnected\" ? \"opacity-50 cursor-not-allowed\" : \"\"}`}\n              title={isMuted ? \"Unmute Mic\" : \"Mute Mic\"}\n            >\n              {isMuted ? <MicOff className=\"w-4 h-4 text-red-400\" /> : <Mic className=\"w-4 h-4 text-emerald-400\" />}\n              <span className=\"text-[10px] font-semibold\">{isMuted ? \"Muted\" : \"Mic\"}</span>\n            </button>\n\n            {/* Pause / Resume Button */}\n            <button\n              onClick={() => setIsPaused(!isPaused)}\n              disabled={state === \"disconnected\"}\n              className={`p-3 rounded-2xl flex flex-col items-center justify-center gap-1 transition-all border ${\n                isPaused\n                  ? \"bg-amber-500/20 border-amber-500/40 text-amber-300\"\n                  : \"bg-slate-800 hover:bg-slate-700 border-white/10 text-slate-200\"\n              } ${state === \"disconnected\" ? \"opacity-50 cursor-not-allowed\" : \"\"}`}\n              title={isPaused ? \"Resume Session\" : \"Pause Session\"}\n            >\n              {isPaused ? <Play className=\"w-4 h-4 text-amber-400\" /> : <Pause className=\"w-4 h-4 text-amber-300\" />}\n              <span className=\"text-[10px] font-semibold\">{isPaused ? \"Resume\" : \"Pause\"}</span>\n            </button>\n\n            {/* Stop / Disconnect Button */}\n            <button\n              onClick={onToggleSession}\n              className={`p-3 rounded-2xl flex flex-col items-center justify-center gap-1 transition-all border ${\n                state !== \"disconnected\"\n                  ? \"bg-red-600/30 hover:bg-red-600/50 border-red-500/50 text-red-200\"\n                  : \"bg-emerald-600/30 hover:bg-emerald-600/50 border-emerald-500/50 text-emerald-200\"\n              }`}\n              title={state !== \"disconnected\" ? \"Disconnect Voice\" : \"Start Voice\"}\n            >\n              {state !== \"disconnected\" ? (\n                <Square className=\"w-4 h-4 text-red-400 fill-red-400\" />\n              ) : (\n                <Play className=\"w-4 h-4 text-emerald-400 fill-emerald-400\" />\n              )}\n              <span className=\"text-[10px] font-semibold\">\n                {state !== \"disconnected\" ? \"Stop\" : \"Connect\"}\n              </span>\n            </button>\n\n            {/* Quick Drawers & Extras Button */}\n            <button\n              onClick={onOpenSettingsModal}\n              className=\"p-3 rounded-2xl bg-slate-800 hover:bg-slate-700 border border-white/10 text-slate-200 flex flex-col items-center justify-center gap-1 transition-all\"\n              title=\"Settings & Tools\"\n            >\n              <Settings className=\"w-4 h-4 text-purple-400\" />\n              <span className=\"text-[10px] font-semibold\">Settings</span>\n            </button>\n          </div>\n\n          {/* Quick Utility Toolbar Badges */}\n          <div className=\"flex items-center justify-between text-slate-400 text-xs pt-1 border-t border-white/5\">\n            <button\n              onClick={onOpenVoiceModal}\n              className=\"px-2 py-1 rounded-xl bg-slate-950/60 hover:bg-slate-800 text-[11px] text-slate-300 font-medium transition-all border border-white/5 flex items-center gap-1\"\n            >\n              <Radio className=\"w-3 h-3 text-pink-400\" />\n              <span>Voice</span>\n            </button>\n\n            <button\n              onClick={onOpenAmbientModal}\n              className=\"px-2 py-1 rounded-xl bg-slate-950/60 hover:bg-slate-800 text-[11px] text-slate-300 font-medium transition-all border border-white/5 flex items-center gap-1\"\n            >\n              <Volume2 className=\"w-3 h-3 text-cyan-400\" />\n              <span>Ambient</span>\n            </button>\n\n            <button\n              onClick={onOpenNotesDrawer}\n              className=\"px-2 py-1 rounded-xl bg-slate-950/60 hover:bg-slate-800 text-[11px] text-slate-300 font-medium transition-all border border-white/5 flex items-center gap-1 relative\"\n            >\n              <StickyNote className=\"w-3 h-3 text-amber-400\" />\n              <span>Notes</span>\n              {noteCount > 0 && (\n                <span className=\"px-1 py-0.2 rounded-full bg-amber-500 text-black text-[9px] font-bold ml-0.5\">\n                  {noteCount}\n                </span>\n              )}\n            </button>\n\n            <button\n              onClick={onOpenToolLogsDrawer}\n              className=\"px-2 py-1 rounded-xl bg-slate-950/60 hover:bg-slate-800 text-[11px] text-slate-300 font-medium transition-all border border-white/5 flex items-center gap-1\"\n            >\n              <Terminal className=\"w-3 h-3 text-purple-400\" />\n              <span>Logs</span>\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
