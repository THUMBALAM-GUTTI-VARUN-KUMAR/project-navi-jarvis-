    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { X, Bookmark, Trash2, ExternalLink, Globe } from \"lucide-react\";\nimport { BookmarkItem } from \"../../types/browser\";\n\ninterface BookmarksDrawerProps {\n  isOpen: boolean;\n  bookmarks: BookmarkItem[];\n  onSelectBookmark: (url: string) => void;\n  onRemoveBookmark: (id: string) => void;\n  onClose: () => void;\n}\n\nexport const BookmarksDrawer: React.FC<BookmarksDrawerProps> = ({\n  isOpen,\n  bookmarks,\n  onSelectBookmark,\n  onRemoveBookmark,\n  onClose,\n}) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex justify-end bg-slate-950/80 backdrop-blur-md animate-in fade-in\">\n      <div className=\"w-full max-w-md h-full bg-slate-900 border-l border-white/10 p-6 flex flex-col shadow-2xl overflow-hidden\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-4 border-b border-white/10 shrink-0\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2.5 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/30\">\n              <Bookmark className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-bold text-white\">Browser Bookmarks</h3>\n              <p className=\"text-xs text-slate-400\">Your saved websites and quick links</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-all\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* List */}\n        <div className=\"flex-1 overflow-y-auto py-4 space-y-2.5\">\n          {bookmarks.length === 0 ? (\n            <div className=\"text-center py-16 px-4\">\n              <Bookmark className=\"w-10 h-10 text-slate-600 mx-auto mb-3\" />\n              <p className=\"text-sm font-medium text-slate-300 mb-1\">No bookmarks saved yet</p>\n              <p className=\"text-xs text-slate-500\">\n                Click the star icon in the address bar on any webpage to save it here.\n              </p>\n            </div>\n          ) : (\n            bookmarks.map((bm) => (\n              <div\n                key={bm.id}\n                className=\"p-3.5 rounded-2xl bg-slate-800/60 border border-white/5 hover:border-amber-500/30 transition-all flex items-center justify-between gap-3 group\"\n              >\n                <button\n                  onClick={() => {\n                    onSelectBookmark(bm.url);\n                    onClose();\n                  }}\n                  className=\"flex-1 text-left flex items-center gap-3 overflow-hidden\"\n                >\n                  <div className=\"w-8 h-8 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center justify-center shrink-0\">\n                    <Globe className=\"w-4 h-4\" />\n                  </div>\n                  <div className=\"overflow-hidden\">\n                    <h4 className=\"text-xs font-bold text-white truncate group-hover:text-amber-300 transition-colors\">\n                      {bm.title}\n                    </h4>\n                    <p className=\"text-[10px] text-slate-400 truncate\">{bm.url}</p>\n                  </div>\n                </button>\n                <div className=\"flex items-center gap-1 shrink-0\">\n                  <button\n                    onClick={() => {\n                      onSelectBookmark(bm.url);\n                      onClose();\n                    }}\n                    className=\"p-2 rounded-xl hover:bg-slate-700 text-slate-400 hover:text-white transition-all\"\n                    title=\"Open URL\"\n                  >\n                    <ExternalLink className=\"w-4 h-4\" />\n                  </button>\n                  <button\n                    onClick={() => onRemoveBookmark(bm.id)}\n                    className=\"p-2 rounded-xl hover:bg-red-500/20 text-slate-500 hover:text-red-400 transition-all\"\n                    title=\"Delete Bookmark\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
