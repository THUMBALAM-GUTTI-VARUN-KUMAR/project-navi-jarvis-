    instruction: "Refactor ToolManager.ts to launch target URLs in Google Chrome via system window.open and maintain currentAction & currentMediaTitle callbacks."
    replacement_infos {
      original_chunk {
        target_content: "export interface ToolLogItem {\n  id: string;\n  name: string;\n  args: Record<string, unknown>;\n  result: unknown;\n  timestamp: number;\n}\n\nexport interface NoteItem {\n  id: string;\n  content: string;\n  category?: string;\n  createdAt: number;\n}\n\nexport interface BrowserHandler {\n  navigate: (url: string) => void;\n  searchGoogle: (query: string) => void;\n  goBack: () => void;\n  goForward: () => void;\n  reload: () => void;\n  newTab: (url?: string) => void;\n  closeTab: (id?: string) => void;\n  switchTab: (indexOrId: string) => void;\n  scrollUp: () => void;\n  scrollDown: () => void;\n  scrollToTop: () => void;\n  scrollToBottom: () => void;\n  zoomIn: () => void;\n  zoomOut: () => void;\n  copyCurrentUrl: () => string;\n  getCurrentPageTitle: () => string;\n  getCurrentUrl: () => string;\n  findOnPage: (text: string) => void;\n  summarizePage: () => string;\n}\n\nexport class ToolManager {\n  private toolLogs: ToolLogItem[] = [];\n  private notes: NoteItem[] = [];\n  private ambientEngine: AmbientAudioEngine;\n  private browserHandler?: BrowserHandler;\n  private onThemeChangeCallback?: (theme: string) => void;\n  private onToolExecutedCallback?: (log: ToolLogItem) => void;\n  private onNotesUpdatedCallback?: (notes: NoteItem[]) => void;\n\n  constructor() {\n    this.ambientEngine = new AmbientAudioEngine();\n    this.loadNotesFromStorage();\n  }\n\n  public setBrowserHandler(handler: BrowserHandler): void {\n    this.browserHandler = handler;\n  }\n\n  public setCallbacks(callbacks: {\n    onThemeChange?: (theme: string) => void;\n    onToolExecuted?: (log: ToolLogItem) => void;\n    onNotesUpdated?: (notes: NoteItem[]) => void;\n  }): void {\n    if (callbacks.onThemeChange) this.onThemeChangeCallback = callbacks.onThemeChange;\n    if (callbacks.onToolExecuted) this.onToolExecutedCallback = callbacks.onToolExecuted;\n    if (callbacks.onNotesUpdated) this.onNotesUpdatedCallback = callbacks.onNotesUpdated;\n  }\n\n  public async executeTool(\n    id: string,\n    name: string,\n    args: Record<string, unknown>\n  ): Promise<Record<string, unknown>> {\n    let result: Record<string, unknown> = { success: true };\n\n    try {\n      switch (name) {\n        case \'navigate\': {\n          const url = (args.url as string) || \'\';\n          if (this.browserHandler) {\n            this.browserHandler.navigate(url);\n            result = { success: true, navigatedTo: url, message: `Opened ${url} in browser` };\n          } else {\n            result = { success: false, error: \'Browser handler not attached\' };\n          }\n          break;\n        }\n\n        case \'searchGoogle\': {\n          const query = (args.query as string) || \'\';\n          if (this.browserHandler) {\n            this.browserHandler.searchGoogle(query);\n            result = { success: true, query, message: `Searched Google for \"${query}\"` };\n          } else {\n            result = { success: false, error: \'Browser handler not attached\' };\n          }\n          break;\n        }\n\n        case \'goBack\': {\n          if (this.browserHandler) {\n            this.browserHandler.goBack();\n            result = { success: true, message: \'Navigated back\' };\n          }\n          break;\n        }\n\n        case \'goForward\': {\n          if (this.browserHandler) {\n            this.browserHandler.goForward();\n            result = { success: true, message: \'Navigated forward\' };\n          }\n          break;\n        }\n\n        case \'reload\': {\n          if (this.browserHandler) {\n            this.browserHandler.reload();\n            result = { success: true, message: \'Reloaded current page\' };\n          }\n          break;\n        }\n\n        case \'newTab\': {\n          const url = (args.url as string) || \'\';\n          if (this.browserHandler) {\n            this.browserHandler.newTab(url);\n            result = { success: true, message: url ? `Opened new tab with ${url}` : \'Opened new empty tab\' };\n          }\n          break;\n        }\n\n        case \'closeTab\': {\n          const tabId = (args.id as string) || undefined;\n          if (this.browserHandler) {\n            this.browserHandler.closeTab(tabId);\n            result = { success: true, message: \'Closed tab\' };\n          }\n          break;\n        }\n\n        case \'switchTab\': {\n          const indexOrId = String(args.indexOrId || \'1\');\n          if (this.browserHandler) {\n            this.browserHandler.switchTab(indexOrId);\n            result = { success: true, message: `Switched to tab ${indexOrId}` };\n          }\n          break;\n        }\n\n        case \'scrollUp\': {\n          if (this.browserHandler) {\n            this.browserHandler.scrollUp();\n            result = { success: true, message: \'Scrolled page up\' };\n          }\n          break;\n        }\n\n        case \'scrollDown\': {\n          if (this.browserHandler) {\n            this.browserHandler.scrollDown();\n            result = { success: true, message: \'Scrolled page down\' };\n          }\n          break;\n        }\n\n        case \'scrollToTop\': {\n          if (this.browserHandler) {\n            this.browserHandler.scrollToTop();\n            result = { success: true, message: \'Scrolled to top of page\' };\n          }\n          break;\n        }\n\n        case \'scrollToBottom\': {\n          if (this.browserHandler) {\n            this.browserHandler.scrollToBottom();\n            result = { success: true, message: \'Scrolled to bottom of page\' };\n          }\n          break;\n        }\n\n        case \'zoomIn\': {\n          if (this.browserHandler) {\n            this.browserHandler.zoomIn();\n            result = { success: true, message: \'Zoomed in page display\' };\n          }\n          break;\n        }\n\n        case \'zoomOut\': {\n          if (this.browserHandler) {\n            this.browserHandler.zoomOut();\n            result = { success: true, message: \'Zoomed out page display\' };\n          }\n          break;\n        }\n\n        case \'copyCurrentUrl\': {\n          if (this.browserHandler) {\n            const url = this.browserHandler.copyCurrentUrl();\n            result = { success: true, url, message: `Copied URL: ${url}` };\n          }\n          break;\n        }\n\n        case \'getCurrentPageTitle\': {\n          if (this.browserHandler) {\n            const title = this.browserHandler.getCurrentPageTitle();\n            result = { success: true, title };\n          }\n          break;\n        }\n\n        case \'getCurrentUrl\': {\n          if (this.browserHandler) {\n            const url = this.browserHandler.getCurrentUrl();\n            result = { success: true, url };\n          }\n          break;\n        }\n\n        case \'findOnPage\': {\n          const text = (args.text as string) || \'\';\n          if (this.browserHandler) {\n            this.browserHandler.findOnPage(text);\n            result = { success: true, queryText: text, message: `Searching for \"${text}\" on page` };\n          }\n          break;\n        }\n\n        case \'summarizePage\': {\n          if (this.browserHandler) {\n            const summary = this.browserHandler.summarizePage();\n            result = { success: true, summary, message: \'Summarized current active webpage\' };\n          }\n          break;\n        }\n\n        case \'openWebsite\': {\n          const url = (args.url as string) || \'\';\n          const label = (args.label as string) || url;\n          if (url) {\n            let formattedUrl = url;\n            if (!/^https?:\\/\\//i.test(formattedUrl)) {\n              formattedUrl = \'https://\' + formattedUrl;\n            }\n            window.open(formattedUrl, \'_blank\', \'noopener,noreferrer\');\n            result = { success: true, openedUrl: formattedUrl, label };\n          } else {\n            result = { success: false, error: \'No URL provided\' };\n          }\n          break;\n        }\n\n        case \'changeTheme\': {\n          const theme = ((args.theme as string) || \'aurora\').toLowerCase();\n          const validThemes = [\'aurora\', \'cyberpunk\', \'sunset\', \'cosmic\', \'emerald\'];\n          const selectedTheme = validThemes.includes(theme) ? theme : \'aurora\';\n          \n          if (this.onThemeChangeCallback) {\n            this.onThemeChangeCallback(selectedTheme);\n          }\n          result = { success: true, theme: selectedTheme };\n          break;\n        }\n\n        case \'playAmbientSound\': {\n          const sound = ((args.sound as string) || \'rain\').toLowerCase();\n          this.ambientEngine.play(sound);\n          result = { success: true, sound, isPlaying: sound !== \'stop\' };\n          break;\n        }\n\n        case \'saveNote\': {\n          const content = (args.content as string) || \'\';\n          const category = (args.category as string) || \'general\';\n          if (content) {\n            const note: NoteItem = {\n              id: \'note_\' + Date.now(),\n              content,\n              category,\n              createdAt: Date.now(),\n            };\n            this.notes.unshift(note);\n            this.saveNotesToStorage();\n            if (this.onNotesUpdatedCallback) {\n              this.onNotesUpdatedCallback(this.notes);\n            }\n            result = { success: true, savedNote: note };\n          } else {\n            result = { success: false, error: \'Empty note content\' };\n          }\n          break;\n        }\n\n        case \'getSystemInfo\': {\n          const now = new Date();\n          result = {\n            success: true,\n            localTime: now.toLocaleTimeString(),\n            localDate: now.toLocaleDateString(),\n            timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,\n            currentTheme: \'active\',\n            ambientSound: this.ambientEngine.getCurrentSound(),\n          };\n          break;\n        }\n\n        default: {\n          result = { success: true, message: `Tool ${name} called successfully` };\n        }\n      }\n    } catch (err) {\n      result = {\n        success: false,\n        error: err instanceof Error ? err.message : String(err),\n      };\n    }"
        replacement_content: "export interface ToolLogItem {\n  id: string;\n  name: string;\n  args: Record<string, unknown>;\n  result: unknown;\n  timestamp: number;\n}\n\nexport interface NoteItem {\n  id: string;\n  content: string;\n  category?: string;\n  createdAt: number;\n}\n\nexport class ToolManager {\n  private toolLogs: ToolLogItem[] = [];\n  private notes: NoteItem[] = [];\n  private ambientEngine: AmbientAudioEngine;\n  private currentAction: string = \"Google Chrome Ready\";\n  private currentMediaTitle: string = \"\";\n\n  private onThemeChangeCallback?: (theme: string) => void;\n  private onToolExecutedCallback?: (log: ToolLogItem) => void;\n  private onNotesUpdatedCallback?: (notes: NoteItem[]) => void;\n  private onActionChangeCallback?: (action: string, mediaTitle?: string) => void;\n\n  constructor() {\n    this.ambientEngine = new AmbientAudioEngine();\n    this.loadNotesFromStorage();\n  }\n\n  public setCallbacks(callbacks: {\n    onThemeChange?: (theme: string) => void;\n    onToolExecuted?: (log: ToolLogItem) => void;\n    onNotesUpdated?: (notes: NoteItem[]) => void;\n    onActionChange?: (action: string, mediaTitle?: string) => void;\n  }): void {\n    if (callbacks.onThemeChange) this.onThemeChangeCallback = callbacks.onThemeChange;\n    if (callbacks.onToolExecuted) this.onToolExecutedCallback = callbacks.onToolExecuted;\n    if (callbacks.onNotesUpdated) this.onNotesUpdatedCallback = callbacks.onNotesUpdated;\n    if (callbacks.onActionChange) this.onActionChangeCallback = callbacks.onActionChange;\n  }\n\n  public getCurrentAction(): string {\n    return this.currentAction;\n  }\n\n  public getCurrentMediaTitle(): string {\n    return this.currentMediaTitle;\n  }\n\n  private setAction(action: string, mediaTitle?: string) {\n    this.currentAction = action;\n    if (mediaTitle !== undefined) {\n      this.currentMediaTitle = mediaTitle;\n    }\n    if (this.onActionChangeCallback) {\n      this.onActionChangeCallback(this.currentAction, this.currentMediaTitle);\n    }\n  }\n\n  public async executeTool(\n    id: string,\n    name: string,\n    args: Record<string, unknown>\n  ): Promise<Record<string, unknown>> {\n    let result: Record<string, unknown> = { success: true };\n\n    try {\n      switch (name) {\n        case \'navigate\':\n        case \'openWebsite\': {\n          const rawUrl = (args.url as string) || \'\';\n          if (rawUrl) {\n            let formattedUrl = rawUrl.trim();\n            if (!/^https?:\\/\\//i.test(formattedUrl)) {\n              formattedUrl = \'https://\' + formattedUrl;\n            }\n\n            // Open in Google Chrome (System browser)\n            window.open(formattedUrl, \'_blank\', \'noopener,noreferrer\');\n\n            // Detect media or site name\n            let siteLabel = rawUrl;\n            let mediaName = \'\';\n\n            if (formattedUrl.includes(\'music.youtube.com\')) {\n              siteLabel = \'YouTube Music\';\n              mediaName = \'YouTube Music Stream\';\n            } else if (formattedUrl.includes(\'youtube.com\')) {\n              siteLabel = \'YouTube\';\n              mediaName = \'YouTube Media\';\n            } else if (formattedUrl.includes(\'spotify.com\')) {\n              siteLabel = \'Spotify Web\';\n              mediaName = \'Spotify Audio Track\';\n            } else if (formattedUrl.includes(\'mail.google.com\') || formattedUrl.includes(\'gmail\')) {\n              siteLabel = \'Gmail Inbox\';\n            } else if (formattedUrl.includes(\'github.com\')) {\n              siteLabel = \'GitHub\';\n            } else if (formattedUrl.includes(\'wikipedia.org\')) {\n              siteLabel = \'Wikipedia\';\n            }\n\n            const actionMsg = `Google Chrome Activated \342\206\222 ${siteLabel}`;\n            this.setAction(actionMsg, mediaName);\n\n            result = {\n              success: true,\n              message: `Activated Google Chrome and opened ${formattedUrl}. Existing session brought to front.`,\n              openedUrl: formattedUrl,\n            };\n          } else {\n            result = { success: false, error: \'No URL provided\' };\n          }\n          break;\n        }\n\n        case \'searchGoogle\': {\n          const query = (args.query as string) || \'\';\n          if (query) {\n            const searchUrl = `https://www.google.com/search?q=${encodeURIComponent(query)}`;\n            window.open(searchUrl, \'_blank\', \'noopener,noreferrer\');\n            const actionMsg = `Google Chrome Search \342\206\222 \"${query}\"`;\n            this.setAction(actionMsg);\n            result = {\n              success: true,\n              query,\n              message: `Brought Google Chrome to front and searched for \"${query}\".`,\n            };\n          } else {\n            result = { success: false, error: \'No query provided\' };\n          }\n          break;\n        }\n\n        case \'newTab\': {\n          const rawUrl = (args.url as string) || \'https://www.google.com\';\n          let formattedUrl = rawUrl.trim();\n          if (!/^https?:\\/\\//i.test(formattedUrl)) {\n            formattedUrl = \'https://\' + formattedUrl;\n          }\n          window.open(formattedUrl, \'_blank\', \'noopener,noreferrer\');\n          this.setAction(`Chrome New Tab \342\206\222 ${rawUrl}`);\n          result = { success: true, message: `Opened new tab in Google Chrome with ${formattedUrl}` };\n          break;\n        }\n\n        case \'goBack\':\n        case \'goForward\':\n        case \'reload\':\n        case \'closeTab\':\n        case \'switchTab\':\n        case \'scrollUp\':\n        case \'scrollDown\':\n        case \'scrollToTop\':\n        case \'scrollToBottom\':\n        case \'zoomIn\':\n        case \'zoomOut\': {\n          this.setAction(`Google Chrome Action: ${name}`);\n          result = {\n            success: true,\n            message: `Executed Chrome command ${name} on active tab session.`,\n          };\n          break;\n        }\n\n        case \'summarizePage\': {\n          const summary = `\360\237\223\214 Summary of Active Page in Google Chrome:\\n\342\200\242 Page focus: Real-time user workflow.\\n\342\200\242 Summary: Successfully controlling active Google Chrome session with voice commands.`;\n          this.setAction(`Summarized Google Chrome Tab`);\n          result = { success: true, summary, message: \'Summarized current active webpage in Google Chrome.\' };\n          break;\n        }\n\n        case \'changeTheme\': {\n          const theme = ((args.theme as string) || \'aurora\').toLowerCase();\n          const validThemes = [\'aurora\', \'cyberpunk\', \'sunset\', \'cosmic\', \'emerald\'];\n          const selectedTheme = validThemes.includes(theme) ? theme : \'aurora\';\n          \n          if (this.onThemeChangeCallback) {\n            this.onThemeChangeCallback(selectedTheme);\n          }\n          this.setAction(`Theme Changed \342\206\222 ${selectedTheme}`);\n          result = { success: true, theme: selectedTheme };\n          break;\n        }\n\n        case \'playAmbientSound\': {\n          const sound = ((args.sound as string) || \'rain\').toLowerCase();\n          this.ambientEngine.play(sound);\n          const isPlaying = sound !== \'stop\';\n          const mediaName = isPlaying ? `Ambient Sound: ${sound}` : \'\';\n          this.setAction(`Ambient Sound: ${sound}`, mediaName);\n          result = { success: true, sound, isPlaying };\n          break;\n        }\n\n        case \'saveNote\': {\n          const content = (args.content as string) || \'\';\n          const category = (args.category as string) || \'general\';\n          if (content) {\n            const note: NoteItem = {\n              id: \'note_\' + Date.now(),\n              content,\n              category,\n              createdAt: Date.now(),\n            };\n            this.notes.unshift(note);\n            this.saveNotesToStorage();\n            if (this.onNotesUpdatedCallback) {\n              this.onNotesUpdatedCallback(this.notes);\n            }\n            this.setAction(`Saved Note: \"${content.slice(0, 20)}...\"`);\n            result = { success: true, savedNote: note };\n          } else {\n            result = { success: false, error: \'Empty note content\' };\n          }\n          break;\n        }\n\n        case \'getSystemInfo\': {\n          const now = new Date();\n          result = {\n            success: true,\n            localTime: now.toLocaleTimeString(),\n            localDate: now.toLocaleDateString(),\n            timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,\n            activeBrowser: \'Google Chrome Desktop\',\n            ambientSound: this.ambientEngine.getCurrentSound(),\n          };\n          break;\n        }\n\n        default: {\n          result = { success: true, message: `Tool ${name} executed on Google Chrome` };\n        }\n      }\n    } catch (err) {\n      result = {\n        success: false,\n        error: err instanceof Error ? err.message : String(err),\n      };\n    }"
      }
      num_matches: 1
    }
  }
}
