    instruction: "Add integrated browser control functions to server toolsConfig and system prompt"
    replacement_infos {
      original_chunk {
        target_content: "Tools available to you:\n- openWebsite(url: string, label?: string): Opens a web page in a new tab when requested by the user.\n- changeTheme(theme: string): Changes the visual background glow theme: \'aurora\', \'cyberpunk\', \'sunset\', \'cosmic\', or \'emerald\'.\n- playAmbientSound(sound: string): Plays ambient background audio: \'rain\', \'waves\', \'lofi_chimes\', \'cozy_cafe\', \'fireplace\', or \'stop\'.\n- saveNote(content: string, category?: string): Saves a quick note or reminder for the user.\n- getSystemInfo(): Retrieves current date, local time, and session metadata.\n\nAlways use these tool functions whenever the user asks you to perform an action!\n`;\n\nconst toolsConfig = [\n  {\n    functionDeclarations: [\n      {\n        name: \"openWebsite\",\n        description: \"Opens a website or web address in a new browser tab for the user.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            url: {\n              type: Type.STRING,\n              description: \"Full URL to open (e.g. https://wikipedia.org or https://google.com)\",\n            },\n            label: {\n              type: Type.STRING,\n              description: \"Optional descriptive label for the website\",\n            },\n          },\n          required: [\"url\"],\n        },\n      },\n      {\n        name: \"changeTheme\",\n        description: \"Changes the visual atmospheric color theme of Navi\'s interface.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            theme: {\n              type: Type.STRING,\n              description: \"Theme option: \'aurora\', \'cyberpunk\', \'sunset\', \'cosmic\', or \'emerald\'\",\n            },\n          },\n          required: [\"theme\"],\n        },\n      },\n      {\n        name: \"playAmbientSound\",\n        description: \"Plays ambient soundscapes like rain, ocean waves, lofi chimes, cozy cafe, or fireplace.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            sound: {\n              type: Type.STRING,\n              description: \"Sound name: \'rain\', \'waves\', \'lofi_chimes\', \'cozy_cafe\', \'fireplace\', or \'stop\'\",\n            },\n          },\n          required: [\"sound\"],\n        },\n      },\n      {\n        name: \"saveNote\",\n        description: \"Saves a note, reminder, or favorite topic mentioned by the user during session.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            content: {\n              type: Type.STRING,\n              description: \"Note text to save\",\n            },\n            category: {\n              type: Type.STRING,\n              description: \"Category like \'reminder\', \'favorite\', \'idea\', \'todo\'\",\n            },\n          },\n          required: [\"content\"],\n        },\n      },\n      {\n        name: \"getSystemInfo\",\n        description: \"Retrieves current local time, date, and user browser system context.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n    ],\n  },\n];"
        replacement_content: "Tools available to you:\n- navigate(url: string): Opens or navigates the browser to a given URL or website name.\n- searchGoogle(query: string): Performs a Google search for the specified query in the browser.\n- goBack(): Navigates the current browser tab back one page.\n- goForward(): Navigates the current browser tab forward one page.\n- reload(): Reloads/refreshes the current active page.\n- newTab(url?: string): Opens a new browser tab with optional URL.\n- closeTab(id?: string): Closes the active or specified browser tab.\n- switchTab(indexOrId: string): Switches to a tab by its 1-based index (e.g. \"1\", \"2\") or ID.\n- scrollUp(): Scrolls the active browser page upward.\n- scrollDown(): Scrolls the active browser page downward.\n- scrollToTop(): Scrolls to the top of the current page.\n- scrollToBottom(): Scrolls to the bottom of the current page.\n- zoomIn(): Zooms in the current page display.\n- zoomOut(): Zooms out the current page display.\n- copyCurrentUrl(): Copies the current tab URL.\n- getCurrentPageTitle(): Returns title of current active web page.\n- getCurrentUrl(): Returns URL of current active web page.\n- findOnPage(text: string): Finds and highlights text on the active web page.\n- summarizePage(): Summarizes the content of the current active webpage for the user.\n- openWebsite(url: string, label?: string): Opens a website or web address for the user.\n- changeTheme(theme: string): Changes visual background theme: \'aurora\', \'cyberpunk\', \'sunset\', \'cosmic\', or \'emerald\'.\n- playAmbientSound(sound: string): Plays ambient background audio: \'rain\', \'waves\', \'lofi_chimes\', \'cozy_cafe\', \'fireplace\', or \'stop\'.\n- saveNote(content: string, category?: string): Saves a quick note or reminder.\n- getSystemInfo(): Retrieves current date, local time, and system metadata.\n\nAlways use these tool functions whenever the user asks you to perform an action!\n`;\n\nconst toolsConfig = [\n  {\n    functionDeclarations: [\n      {\n        name: \"navigate\",\n        description: \"Navigates the embedded browser to a website URL or opens a domain (e.g., youtube.com, wikipedia.org, github.com).\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            url: {\n              type: Type.STRING,\n              description: \"Target URL or web domain to navigate to\",\n            },\n          },\n          required: [\"url\"],\n        },\n      },\n      {\n        name: \"searchGoogle\",\n        description: \"Searches Google for a keyword or topic in the active browser tab.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            query: {\n              type: Type.STRING,\n              description: \"Search query keywords\",\n            },\n          },\n          required: [\"query\"],\n        },\n      },\n      {\n        name: \"goBack\",\n        description: \"Navigates the active browser tab back to the previous page in history.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"goForward\",\n        description: \"Navigates the active browser tab forward in history.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"reload\",\n        description: \"Refreshes/reloads the current active page in the embedded browser.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"newTab\",\n        description: \"Opens a new tab in the embedded browser, optionally with a specified URL.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            url: {\n              type: Type.STRING,\n              description: \"Optional URL to open in the new tab\",\n            },\n          },\n        },\n      },\n      {\n        name: \"closeTab\",\n        description: \"Closes the current active browser tab or specified tab ID.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            id: {\n              type: Type.STRING,\n              description: \"Optional tab ID to close\",\n            },\n          },\n        },\n      },\n      {\n        name: \"switchTab\",\n        description: \"Switches active tab by 1-based index number (e.g., \'1\', \'2\') or tab ID.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            indexOrId: {\n              type: Type.STRING,\n              description: \"Tab number (\'1\', \'2\', \'3\') or tab ID\",\n            },\n          },\n          required: [\"indexOrId\"],\n        },\n      },\n      {\n        name: \"scrollUp\",\n        description: \"Scrolls the active browser page upward.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"scrollDown\",\n        description: \"Scrolls the active browser page downward.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"scrollToTop\",\n        description: \"Scrolls to the top of the active browser page.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"scrollToBottom\",\n        description: \"Scrolls to the very bottom of the active browser page.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"zoomIn\",\n        description: \"Increases zoom magnification level of active browser tab.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"zoomOut\",\n        description: \"Decreases zoom magnification level of active browser tab.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"copyCurrentUrl\",\n        description: \"Copies current tab URL to user clipboard.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"getCurrentPageTitle\",\n        description: \"Returns the title of the current active webpage.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"getCurrentUrl\",\n        description: \"Returns the URL of the current active webpage.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"findOnPage\",\n        description: \"Searches and highlights text matches on the current active page.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            text: {\n              type: Type.STRING,\n              description: \"Search text to locate on current page\",\n            },\n          },\n          required: [\"text\"],\n        },\n      },\n      {\n        name: \"summarizePage\",\n        description: \"Provides an AI summary and overview of the active webpage.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n      {\n        name: \"openWebsite\",\n        description: \"Opens a website or web address in a new browser tab for the user.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            url: {\n              type: Type.STRING,\n              description: \"Full URL to open (e.g. https://wikipedia.org or https://google.com)\",\n            },\n            label: {\n              type: Type.STRING,\n              description: \"Optional descriptive label for the website\",\n            },\n          },\n          required: [\"url\"],\n        },\n      },\n      {\n        name: \"changeTheme\",\n        description: \"Changes the visual atmospheric color theme of Navi\'s interface.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            theme: {\n              type: Type.STRING,\n              description: \"Theme option: \'aurora\', \'cyberpunk\', \'sunset\', \'cosmic\', or \'emerald\'\",\n            },\n          },\n          required: [\"theme\"],\n        },\n      },\n      {\n        name: \"playAmbientSound\",\n        description: \"Plays ambient soundscapes like rain, ocean waves, lofi chimes, cozy cafe, or fireplace.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            sound: {\n              type: Type.STRING,\n              description: \"Sound name: \'rain\', \'waves\', \'lofi_chimes\', \'cozy_cafe\', \'fireplace\', or \'stop\'\",\n            },\n          },\n          required: [\"sound\"],\n        },\n      },\n      {\n        name: \"saveNote\",\n        description: \"Saves a note, reminder, or favorite topic mentioned by the user during session.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {\n            content: {\n              type: Type.STRING,\n              description: \"Note text to save\",\n            },\n            category: {\n              type: Type.STRING,\n              description: \"Category like \'reminder\', \'favorite\', \'idea\', \'todo\'\",\n            },\n          },\n          required: [\"content\"],\n        },\n      },\n      {\n        name: \"getSystemInfo\",\n        description: \"Retrieves current local time, date, and user browser system context.\",\n        parameters: {\n          type: Type.OBJECT,\n          properties: {},\n        },\n      },\n    ],\n  },\n];"
