    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport {\n  Search,\n  Globe,\n  Sparkles,\n  Bookmark,\n  Compass,\n  ArrowRight,\n  ExternalLink,\n  Shield,\n  Zap,\n} from \"lucide-react\";\nimport { BookmarkItem } from \"../../types/browser\";\n\ninterface NewTabDashboardProps {\n  onNavigate: (url: string) => void;\n  bookmarks: BookmarkItem[];\n}\n\nconst FEATURED_SHORTCUTS = [\n  { name: \"Google\", url: \"https://www.google.com\", category: \"Search\", bg: \"from-blue-600 to-indigo-600\" },\n  { name: \"YouTube\", url: \"https://www.youtube.com\", category: \"Video\", bg: \"from-red-600 to-rose-600\" },\n  { name: \"Wikipedia\", url: \"https://www.wikipedia.org\", category: \"Knowledge\", bg: \"from-slate-700 to-slate-900\" },\n  { name: \"GitHub\", url: \"https://github.com\", category: \"Developer\", bg: \"from-purple-900 to-slate-900\" },\n  { name: \"Gmail\", url: \"https://mail.google.com\", category: \"Email\", bg: \"from-red-500 to-amber-600\" },\n  { name: \"Reddit\", url: \"https://www.reddit.com\", category: \"Community\", bg: \"from-orange-600 to-amber-600\" },\n  { name: \"TechCrunch\", url: \"https://techcrunch.com\", category: \"News\", bg: \"from-emerald-600 to-teal-700\" },\n  { name: \"Hacker News\", url: \"https://news.ycombinator.com\", category: \"News\", bg: \"from-amber-600 to-orange-700\" },\n];\n\nexport const NewTabDashboard: React.FC<NewTabDashboardProps> = ({\n  onNavigate,\n  bookmarks,\n}) => {\n  const [searchInput, setSearchInput] = useState(\"\");\n\n  const handleSearchSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!searchInput.trim()) return;\n    const term = searchInput.trim();\n    if (/^(https?:\\/\\/)?([\\w-]+\\.)+[\\w-]+(\\/.*)?$/i.test(term)) {\n      onNavigate(term.startsWith(\"http\") ? term : `https://${term}`);\n    } else {\n      onNavigate(`https://www.google.com/search?q=${encodeURIComponent(term)}`);\n    }\n  };\n\n  return (\n    <div className=\"w-full h-full overflow-y-auto bg-slate-950/90 text-white p-6 md:p-10 flex flex-col items-center justify-between font-sans\">\n      <div className=\"max-w-3xl w-full mx-auto space-y-8 my-auto\">\n        {/* Header Hero */}\n        <div className=\"text-center space-y-3\">\n          <div className=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-500/10 border border-purple-500/30 text-purple-300 text-xs font-semibold shadow-lg shadow-purple-500/10\">\n            <Sparkles className=\"w-4 h-4 text-pink-400 animate-pulse\" />\n            <span>Navi AI OS Workspace</span>\n          </div>\n          <h1 className=\"text-3xl sm:text-5xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-purple-300 bg-clip-text text-transparent\">\n            Where to navigate today?\n          </h1>\n          <p className=\"text-sm text-slate-400 max-w-md mx-auto\">\n            Ask Navi via voice or enter a URL or Google search query below.\n          </p>\n        </div>\n\n        {/* Search Input Bar */}\n        <form onSubmit={handleSearchSubmit} className=\"relative group\">\n          <div className=\"absolute -inset-1 rounded-3xl bg-gradient-to-r from-pink-500 via-purple-500 to-cyan-500 blur-md opacity-30 group-hover:opacity-75 transition duration-500\" />\n          <div className=\"relative flex items-center bg-slate-900/90 backdrop-blur-2xl border border-white/10 rounded-2xl p-2 shadow-2xl\">\n            <Search className=\"w-5 h-5 text-purple-400 ml-3 shrink-0\" />\n            <input\n              type=\"text\"\n              value={searchInput}\n              onChange={(e) => setSearchInput(e.target.value)}\n              placeholder=\"Search Google or enter web URL...\"\n              className=\"w-full px-3 py-2.5 bg-transparent text-white placeholder-slate-500 focus:outline-none text-sm sm:text-base font-medium\"\n            />\n            <button\n              type=\"submit\"\n              className=\"p-2.5 sm:px-5 sm:py-2.5 rounded-xl bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-600 hover:to-purple-700 text-white text-xs font-bold transition-all shadow-lg shadow-pink-500/20 flex items-center gap-1.5 shrink-0\"\n            >\n              <span>Go</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </form>\n\n        {/* Featured App Speed Dials */}\n        <div className=\"space-y-3\">\n          <div className=\"flex items-center justify-between text-xs font-semibold text-slate-400 px-1\">\n            <span className=\"flex items-center gap-1.5\">\n              <Compass className=\"w-4 h-4 text-cyan-400\" />\n              Speed Dial & Top Sites\n            </span>\n            <span className=\"text-slate-500 text-[11px]\">8 Quick Links</span>\n          </div>\n\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n            {FEATURED_SHORTCUTS.map((site) => (\n              <button\n                key={site.name}\n                onClick={() => onNavigate(site.url)}\n                className=\"group relative p-3.5 rounded-2xl bg-slate-900/60 hover:bg-slate-800/80 border border-white/5 hover:border-purple-500/40 transition-all text-left flex flex-col justify-between h-24 hover:-translate-y-0.5 shadow-lg\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div\n                    className={`w-8 h-8 rounded-xl bg-gradient-to-br ${site.bg} flex items-center justify-center text-white text-xs font-bold shadow-md`}\n                  >\n                    {site.name.charAt(0)}\n                  </div>\n                  <ExternalLink className=\"w-3.5 h-3.5 text-slate-600 group-hover:text-slate-300 transition-colors\" />\n                </div>\n                <div>\n                  <h4 className=\"text-xs font-bold text-white group-hover:text-purple-300 transition-colors\">\n                    {site.name}\n                  </h4>\n                  <p className=\"text-[10px] text-slate-500\">{site.category}</p>\n                </div>\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Bookmarks Quick Row */}\n        {bookmarks.length > 0 && (\n          <div className=\"space-y-3 pt-2\">\n            <div className=\"flex items-center gap-1.5 text-xs font-semibold text-slate-400 px-1\">\n              <Bookmark className=\"w-4 h-4 text-amber-400\" />\n              Saved Bookmarks ({bookmarks.length})\n            </div>\n            <div className=\"flex flex-wrap gap-2\">\n              {bookmarks.map((bm) => (\n                <button\n                  key={bm.id}\n                  onClick={() => onNavigate(bm.url)}\n                  className=\"px-3.5 py-2 rounded-xl bg-slate-900/70 hover:bg-slate-800 border border-white/5 hover:border-amber-500/40 text-xs text-slate-300 hover:text-white transition-all flex items-center gap-2\"\n                >\n                  <Globe className=\"w-3.5 h-3.5 text-amber-400\" />\n                  <span className=\"truncate max-w-[140px] font-medium\">{bm.title}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* Voice Command Hints Banner */}\n        <div className=\"p-4 rounded-2xl bg-slate-900/50 border border-white/5 text-xs space-y-2\">\n          <div className=\"flex items-center gap-2 text-purple-300 font-bold\">\n            <Zap className=\"w-4 h-4 text-pink-400\" />\n            <span>Try speaking to Navi:</span>\n          </div>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-slate-400 text-[11px]\">\n            <div className=\"p-2 rounded-xl bg-slate-950/60 border border-white/5\">\n              \360\237\222\254 <span className=\"text-slate-200\">\"Navi, open YouTube\"</span>\n            </div>\n            <div className=\"p-2 rounded-xl bg-slate-950/60 border border-white/5\">\n              \360\237\222\254 <span className=\"text-slate-200\">\"Search Google for React 19 tutorial\"</span>\n            </div>\n            <div className=\"p-2 rounded-xl bg-slate-950/60 border border-white/5\">\n              \360\237\222\254 <span className=\"text-slate-200\">\"Scroll down\" or \"Zoom in\"</span>\n            </div>\n            <div className=\"p-2 rounded-xl bg-slate-950/60 border border-white/5\">\n              \360\237\222\254 <span className=\"text-slate-200\">\"Summarize this page\"</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Footer Security Badges */}\n      <div className=\"mt-8 text-center flex items-center justify-center gap-4 text-[11px] text-slate-500\">\n        <span className=\"flex items-center gap-1\">\n          <Shield className=\"w-3.5 h-3.5 text-emerald-400\" /> Sandboxed Execution\n        </span>\n        <span>\342\200\242</span>\n        <span>Context Isolation Enabled</span>\n        <span>\342\200\242</span>\n        <span>Navi Voice AI Engine v3.1</span>\n      </div>\n    </div>\n  );\n};\n"
