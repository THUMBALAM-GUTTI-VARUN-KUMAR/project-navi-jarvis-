  file_change {
    absolute_path_uri: "file:///src/components/Browser/DownloadsDrawer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { X, Download, CheckCircle2, Loader2, File, ExternalLink } from \"lucide-react\";\nimport { DownloadItem } from \"../../types/browser\";\n\ninterface DownloadsDrawerProps {\n  isOpen: boolean;\n  downloads: DownloadItem[];\n  onClose: () => void;\n}\n\nexport const DownloadsDrawer: React.FC<DownloadsDrawerProps> = ({\n  isOpen,\n  downloads,\n  onClose,\n}) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex justify-end bg-slate-950/80 backdrop-blur-md animate-in fade-in\">\n      <div className=\"w-full max-w-md h-full bg-slate-900 border-l border-white/10 p-6 flex flex-col shadow-2xl overflow-hidden\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-4 border-b border-white/10 shrink-0\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2.5 rounded-xl bg-purple-500/20 text-purple-300 border border-purple-500/30\">\n              <Download className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-bold text-white\">Browser Downloads</h3>\n              <p className=\"text-xs text-slate-400\">File download manager and progress</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-all\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* List */}\n        <div className=\"flex-1 overflow-y-auto py-4 space-y-2.5\">\n          {downloads.length === 0 ? (\n            <div className=\"text-center py-16 px-4\">\n              <Download className=\"w-10 h-10 text-slate-600 mx-auto mb-3\" />\n              <p className=\"text-sm font-medium text-slate-300 mb-1\">No active or recent downloads</p>\n              <p className=\"text-xs text-slate-500\">\n                Downloaded files or documents triggered in browser tabs will show up here.\n              </p>\n            </div>\n          ) : (\n            downloads.map((item) => (\n              <div\n                key={item.id}\n                className=\"p-4 rounded-2xl bg-slate-800/60 border border-white/5 space-y-2\"\n              >\n                <div className=\"flex items-center justify-between gap-3\">\n                  <div className=\"flex items-center gap-3 overflow-hidden\">\n                    <div className=\"p-2.5 rounded-xl bg-slate-900 border border-white/10 text-purple-400 shrink-0\">\n                      <File className=\"w-5 h-5\" />\n                    </div>\n                    <div className=\"overflow-hidden\">\n                      <h4 className=\"text-xs font-bold text-white truncate\">{item.filename}</h4>\n                      <p className=\"text-[10px] text-slate-400\">{item.size}</p>\n                    </div>\n                  </div>\n                  <div className=\"shrink-0\">\n                    {item.status === \"completed\" ? (\n                      <span className=\"flex items-center gap-1 text-xs text-emerald-400 font-semibold\">\n                        <CheckCircle2 className=\"w-4 h-4\" /> Completed\n                      </span>\n                    ) : (\n                      <span className=\"flex items-center gap-1 text-xs text-purple-300 font-semibold animate-pulse\">\n                        <Loader2 className=\"w-4 h-4 animate-spin\" /> {item.progress}%\n                      </span>\n                    )}\n                  </div>\n                </div>\n\n                {/* Progress Bar */}\n                {item.status === \"downloading\" && (\n                  <div className=\"w-full bg-slate-950 rounded-full h-1.5 overflow-hidden\">\n                    <div\n                      className=\"bg-gradient-to-r from-pink-500 to-purple-500 h-full transition-all duration-300\"\n                      style={{ width: `${item.progress}%` }}\n                    />\n                  </div>\n                )}\n              </div>\n            ))\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
