      replacement_content: "import React, { useState } from \"react\";\nimport { X, Sparkles, BookOpen, Copy, Check, MessageSquare } from \"lucide-react\";\n\ninterface PageSummaryModalProps {\n  isOpen: boolean;\n  pageTitle: string;\n  pageUrl: string;\n  summaryText: string;\n  onClose: () => void;\n}\n\nexport const PageSummaryModal: React.FC<PageSummaryModalProps> = ({\n  isOpen,\n  pageTitle,\n  pageUrl,\n  summaryText,\n  onClose,\n}) => {\n  const [copied, setCopied] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(summaryText);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md animate-in fade-in\">\n      <div className=\"relative w-full max-w-lg bg-slate-900 border border-white/10 rounded-3xl p-6 shadow-2xl space-y-4\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-3 border-b border-white/10\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2.5 rounded-xl bg-pink-500/20 text-pink-300 border border-pink-500/30\">\n              <Sparkles className=\"w-5 h-5 text-pink-400\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-bold text-white\">Navi AI Webpage Insight</h3>\n              <p className=\"text-xs text-slate-400 truncate max-w-xs\">{pageTitle || pageUrl}</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-all\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Content Box */}\n        <div className=\"p-4 rounded-2xl bg-slate-950/70 border border-white/5 space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-bold text-purple-300 uppercase tracking-wider flex items-center gap-1.5\">\n              <BookOpen className=\"w-3.5 h-3.5\" /> Key Takeaways\n            </span>\n            <button\n              onClick={handleCopy}\n              className=\"px-2.5 py-1 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium transition-all flex items-center gap-1\"\n            >\n              {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n              <span>{copied ? \"Copied\" : \"Copy\"}</span>\n            </button>\n          </div>\n          <div className=\"text-sm text-slate-200 leading-relaxed space-y-2 whitespace-pre-wrap\">\n            {summaryText}\n          </div>\n        </div>\n\n        {/* Voice Command Tip */}\n        <div className=\"p-3 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center gap-2.5 text-xs text-purple-300\">\n          <MessageSquare className=\"w-4 h-4 shrink-0\" />\n          <span>You can ask Navi: \"Navi, explain this page to me\" anytime during voice sessions!</span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
